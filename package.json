{
  "name": "accessibility-skills",
  "version": "1.0.0",
  "description": "AI agent skills for web accessibility \u2014 WCAG conformance, ARIA patterns, and topic-specific best practices for Claude Code, Cursor, Copilot and other AI agents",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "aria",
    "claude",
    "agent-skills",
    "ai-agent",
    "skills"
  ],
  "homepage": "https://github.com/mgifford/accessibility-skills#readme",
  "bugs": {
    "url": "https://github.com/mgifford/accessibility-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgifford/accessibility-skills.git"
  },
  "license": "AGPL-3.0",
  "author": "Mike Gifford",
  "bin": {
    "cli-audit-inspect": "skills/cli-audit/scripts/cli-inspect.mjs"
  },
  "files": [
    "skills/**"
  ],
  "scripts": {
    "validate:evals": "node scripts/validate-evals.mjs",
    "run:evals": "node scripts/run-evals.mjs",
    "report:evals": "node scripts/run-evals.mjs --output-dir reports",
    "test:csv": "node tests/test-csv-parsing.js",
    "validate:csv": "node tests/test-csv-parsing.js",
    "generate:arrm-roles": "node scripts/generate-role-indexes.js",
    "check:arrm-roles": "node scripts/check-arrm-roles.js",
    "test:shared-fixture": "node tests/validate-shared-fixture.js",
    "test:sync": "node tests/test-sync-check.mjs",
    "test:issues": "node tests/test-upsert-issue.mjs",
    "test:invariants": "node tests/test-repo-invariants.mjs",
    "test": "npm run test:csv && npm run test:sync && npm run test:sync-cli && npm run test:issues && npm run test:invariants",
    "sync:status": "node scripts/sync.mjs status",
    "sync:list": "node scripts/sync.mjs list",
    "sync:diff": "node scripts/sync.mjs diff",
    "sync:review": "node scripts/sync.mjs review",
    "sync:validate": "node scripts/sync.mjs validate",
    "sync:report": "node scripts/sync.mjs report",
    "test:sync-cli": "node tests/test-sync-cli.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.1",
    "playwright": "^1.54.2"
  }
}
